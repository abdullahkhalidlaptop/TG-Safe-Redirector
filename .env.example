# ---- Firebase ----
FIREBASE_RTDB_URL=https://your-project-default-rtdb.REGION.firebasedatabase.app
# On Vercel: paste the full JSON of serviceAccountKey.json into FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY=
# Local dev only:
FIREBASE_KEY_PATH=./serviceAccountKey.json

# ---- Admin / Gate ----
ADMIN_KEY=change-me-admin-key
GATE_KEY=change-me-gate-key
SESSION_TTL_MINUTES=15

# ---- Referer protection ----
ALLOWED_REFERER_HOSTS=tpi.li,shrinkearn.com,shrinkme.io,shorte.st,clicksfly.com,clk.sh

# ---- Rate limit ----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# ---- ShrinkEarn ----
SHRINKEARN_API_KEY=4825225d42b55246758c91d276c03741d58b91fd
SHRINKEARN_ENDPOINT=https://shrinkearn.com/api

# ---- Public URL (used to build gate URLs) ----
# Local:  http://127.0.0.1:8999
# Vercel: https://your-project.vercel.app
PUBLIC_BASE_URL=http://127.0.0.1:8999

# ---- Branding ----
BRAND_NAME=AK Mods Files
BRAND_TAGLINE=Premium Mods & Files
BRAND_LOGO=
BRAND_LOGO_FALLBACK=🎬
BRAND_ACCENT=#0088cc
BRAND_BG=#0f172a
BRAND_CARD=#1e293b
BRAND_TEXT=#e2e8f0
BRAND_FOOTER=Powered by AK Mods

# ---- Server (local only) ----
HOST=0.0.0.0
PORT=8999
DEBUG=true
